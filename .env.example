# Örnek yapılandırma. Kopyala: cp .env.example .env
# .env ASLA commit edilmez (bkz. .gitignore, docs/kapsam.md Bölüm 9).

# --- API ------------------------------------------------------------------
# HALKA AÇILMAZ. Yetkisiz kullanımda sunucu IP'si hedefin loglarına düşer ve
# altyapı sağlayıcı konumuna geçilir. Sistem VPN/Tailscale arkasında çalışır.
API_HOST=127.0.0.1
API_PORT=8000

# --- Veritabanı -----------------------------------------------------------
POSTGRES_USER=osint
POSTGRES_PASSWORD=degistir-beni
POSTGRES_DB=osint
# Container ağı içindeki ad ('db'). api ve worker bunu kullanır.
DATABASE_URL=postgresql+psycopg://osint:degistir-beni@db:5432/osint

# Aynı veritabanının HOST tarafındaki adı. Tanımlıysa DATABASE_URL'i EZER.
# 'db' yalnızca docker compose ağı içinde çözülür; host'tan çalışan alembic ve
# pytest için port 127.0.0.1:5432'ye yayınlanmıştır. Tek bir URL'i iki yere birden
# doğru yazmak mümkün olmadığı için ikinci bir değişken kullanılır.
#
# 'localhost' YAZMAYIN, '127.0.0.1' yazın: Windows'ta 'localhost' önce '::1'e
# (IPv6) çözülür, docker-compose ise portu yalnızca IPv4 127.0.0.1'e yayınlar.
# Her bağlantı önce IPv6'da TCP zaman aşımını bekler (>100 sn) ve her şey donmuş
# gibi görünür.
ALEMBIC_DATABASE_URL=postgresql+psycopg://osint:degistir-beni@127.0.0.1:5432/osint

# --- Kuyruk ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Ham çıktı deposu -----------------------------------------------------
# DB'de sadece referans tutulur; dosyalar burada durur.
RAW_DIR=/data/raw

# --- Zincirleme güvenlik sınırı (docs/veri-modeli.md 2.5) -----------------
MAX_DERINLIK=3

# --- LLM (Gemini) ---------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Tool API anahtarları -------------------------------------------------
# Boş bırakılırsa ilgili tool `saglik()` kontrolünde kapalı kalır.
SHODAN_API_KEY=
SUBFINDER_API_KEYS=
