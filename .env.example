# Örnek yapılandırma. Kopyala: cp .env.example .env
# .env ASLA commit edilmez (bkz. .gitignore, docs/kapsam.md Bölüm 9).

# --- API ------------------------------------------------------------------
# HALKA AÇILMAZ. Yetkisiz kullanımda sunucu IP'si hedefin loglarına düşer ve
# altyapı sağlayıcı konumuna geçilir. Sistem VPN/Tailscale arkasında çalışır.
API_HOST=127.0.0.1
API_PORT=8000

# --- Veritabanı -----------------------------------------------------------
POSTGRES_USER=osint
POSTGRES_PASSWORD=degistir-beni
POSTGRES_DB=osint
# Container ağı içindeki ad ('db'). api ve worker bunu kullanır.
DATABASE_URL=postgresql+psycopg://osint:degistir-beni@db:5432/osint

# Host tarafindaki URL. ARTIK KULLANILMIYOR ve BOS BIRAKILMALIDIR:
# db `osint-data` internal agindadir, host'tan TCP ile erisilemez (yayinlanan
# port internal agda calismaz - olculdu). Bos oldugunda alembic/pytest
# DATABASE_URL'e duser ve container icinde dogru calisir.
# Veri katmani bir gun host'a acilirsa buraya 127.0.0.1'li URL yazilir
# ('localhost' DEGIL: Windows'ta once ::1'e cozulur, docker IPv4 yayinlar).
ALEMBIC_DATABASE_URL=

# --- Kuyruk ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Ham çıktı deposu -----------------------------------------------------
# DB'de sadece referans tutulur; dosyalar burada durur.
RAW_DIR=/data/raw

# Ham cikti arsivinin HOST tarafindaki yolu. Tanimliysa RAW_DIR'i EZER.
# Ayni gerekce: RAW_DIR container icindeki mount noktasidir (/data/raw);
# host'tan calisan runner ve testler icin repo altindaki data/raw gecerlidir.
# Bos birakilirsa repo koku altindaki data/raw kullanilir.
RAW_DIR_HOST=

# --- Zincirleme güvenlik sınırı (docs/veri-modeli.md 2.5) -----------------
MAX_DERINLIK=3

# --- LLM (Gemini) ---------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Tool API anahtarları -------------------------------------------------
# Boş bırakılırsa ilgili tool `saglik()` kontrolünde kapalı kalır.
SHODAN_API_KEY=
SUBFINDER_API_KEYS=
